{
  // Deploys docs/ as static assets on Cloudflare Workers plus a small Worker
  // (worker/index.js) that serves ONLY /api/* (per-user comments stored in the
  // STATE KV namespace, behind Cloudflare Access). See worker/README.md.
  "name": "financial-dashboard1",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./docs",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "STATE", "id": "e65191f8f3af4477ad405715098f267a" }
  ],
  "preview_urls": false
}
